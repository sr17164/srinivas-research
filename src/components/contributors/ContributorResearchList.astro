---
import { getEntry, render } from 'astro:content'

import ContributorCard from '~/components/contributors/ContributorCard.astro'
import Link from '~/components/base/Link.astro'
import {
  getFilteredContributorResearch,
  getMinutesRead,
  getSortedContributorResearch,
} from '~/utils/data'
import { withBasePath } from '~/utils/path'

interface Props {
  limit?: number
  compactEmpty?: boolean
}

const { limit, compactEmpty = false } = Astro.props
const entries = getSortedContributorResearch(
  await getFilteredContributorResearch()
)
const visibleEntries =
  typeof limit === 'number' ? entries.slice(0, limit) : entries

const items = (
  await Promise.all(
    visibleEntries.map(async (entry) => {
      const author = await getEntry(entry.data.author)
      if (!author) return undefined
      const { remarkPluginFrontmatter } = await render(entry)

      return {
        entry,
        author,
        minutesRead: getMinutesRead(
          entry.data.minutesRead,
          remarkPluginFrontmatter.minutesRead as number
        ),
      }
    })
  )
).filter((item) => item !== undefined)
---

{
  items.length > 0 ? (
    <div class="contributor-list">
      {items.map(({ entry, author, minutesRead }) => (
        <ContributorCard
          slug={entry.id}
          title={entry.data.title}
          description={entry.data.description}
          authorName={author.data.fullName}
          authorSlug={author.id}
          pubDate={entry.data.pubDate}
          reportType={entry.data.reportType}
          assetClass={entry.data.assetClass}
          sector={entry.data.sector}
          {minutesRead}
        />
      ))}
    </div>
  ) : (
    <div
      class:list={[
        'contributor-empty',
        compactEmpty && 'contributor-empty-compact',
      ]}
    >
      <p class="contributor-empty-label">Contributor Research</p>
      <h2>We publish selectively, with quality first.</h2>
      <p>
        No Contributor Research has been published yet. If you have a clear
        question and evidence worth testing, we'd like to see it.
      </p>
      <Link
        href={withBasePath('/contributors/submit/')}
        class="contributor-empty-link border-b-none!"
      >
        Review the contributor guide <span aria-hidden="true">→</span>
      </Link>
    </div>
  )
}

<style>
  .contributor-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .contributor-empty {
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid color-mix(in srgb, var(--c-text) 14%, transparent);
    border-top: 0.2rem solid color-mix(in srgb, #2f7778 66%, var(--c-text));
    background: color-mix(in srgb, #2f7778 3%, transparent);
  }

  .contributor-empty-compact {
    padding: clamp(1.5rem, 4vw, 2.75rem);
  }

  .contributor-empty-label {
    margin: 0 0 1rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.48;
  }

  .contributor-empty h2 {
    max-width: 34rem;
    margin: 0;
    font-family: Georgia, Cambria, 'Times New Roman', Times, serif;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  .contributor-empty > p:not(.contributor-empty-label) {
    max-width: 42rem;
    margin: 1rem 0 0;
    font-size: 0.92rem;
    line-height: 1.7;
    opacity: 0.62;
  }

  .contributor-empty-link {
    display: inline-flex;
    gap: 0.65rem;
    margin-top: 1.4rem;
    color: inherit;
    font-size: 0.84rem;
    font-weight: 650;
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .contributor-list {
      grid-template-columns: 1fr;
    }
  }
</style>
