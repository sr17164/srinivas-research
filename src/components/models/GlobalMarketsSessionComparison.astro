---
import { globalMarketsSimulation as simulation } from '~/data/globalMarketsSimulation'

const prior = simulation.priorBuySideSession
const current = simulation.buySide

const usd = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'USD',
  maximumFractionDigits: 0,
})

const usdTwoDecimals = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'USD',
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
})

const percentagePoint = (value: number) => `${value.toFixed(2)}pp`

const getCurrentScore = (label: string) => {
  const score = current.portalSubscores.find((item) => item.label === label)

  if (!score) throw new Error(`Missing current-session portal score: ${label}`)

  return score.value
}

const currentBsrm = getCurrentScore('BSRM')
const currentExecution = getCurrentScore('ES')

const rows = [
  {
    label: 'Composite session score',
    prior: `${prior.exactSessionScore.toFixed(2)}%`,
    current: `${current.exactSessionScore.toFixed(2)}%`,
    change: `+${percentagePoint(
      current.exactSessionScore - prior.exactSessionScore
    )}`,
    tone: 'positive',
  },
  {
    label: 'Composite leaderboard rank',
    prior: String(prior.compositeLeaderboardRank),
    current: String(current.compositeLeaderboardRank),
    change: 'Different cohorts',
    tone: 'neutral',
  },
  {
    label: 'Ending portfolio value',
    prior: usdTwoDecimals.format(prior.financials.portfolioValue),
    current: usdTwoDecimals.format(current.financials.portfolioValue),
    change: `+${usdTwoDecimals.format(
      current.financials.portfolioValue - prior.financials.portfolioValue
    )}`,
    tone: 'positive',
  },
  {
    label: 'Portal P&L field',
    prior: `${usd.format(prior.financials.tradingPnl)} trading P&L`,
    current: `${usd.format(current.financials.totalPnl)} total P&L`,
    change: 'Not directly comparable',
    tone: 'neutral',
  },
  {
    label: 'Commission paid',
    prior: usd.format(prior.financials.commissionPaid),
    current: usd.format(current.financials.commission),
    change: `${usd.format(
      Math.abs(prior.financials.commissionPaid) -
        Math.abs(current.financials.commission)
    )} lower`,
    tone: 'positive',
  },
  {
    label: 'BSRM portal score',
    prior: `${prior.portalMetrics.buySideRiskManagement.toFixed(2)}%`,
    current: `${currentBsrm.toFixed(2)}%`,
    change: `+${percentagePoint(
      currentBsrm - prior.portalMetrics.buySideRiskManagement
    )}`,
    tone: 'positive',
  },
  {
    label: 'Execution portal score',
    prior: `${prior.portalMetrics.execution.toFixed(2)}%`,
    current: `${currentExecution.toFixed(2)}%`,
    change: `+${percentagePoint(
      currentExecution - prior.portalMetrics.execution
    )}`,
    tone: 'positive',
  },
  {
    label: 'Fat-finger incidents',
    prior: String(prior.portalMetrics.fatFingerCount),
    current: String(current.controls.fatFingerIncidents),
    change: 'Removed',
    tone: 'positive',
  },
] as const
---

<section
  class="gm-session-comparison not-prose"
  aria-labelledby="gm-session-comparison-title"
>
  <header>
    <p>Repeated-session evidence</p>
    <h3 id="gm-session-comparison-title">
      15 July baseline versus 22 July principal session
    </h3>
  </header>

  <div class="gm-session-summary">
    <article>
      <span>15 July 2026</span>
      <strong>{prior.exactSessionScore.toFixed(2)}%</strong>
      <p>
        Composite score · ending value{' '}
        {usdTwoDecimals.format(prior.financials.portfolioValue)}
      </p>
    </article>
    <article>
      <span>22 July 2026</span>
      <strong>{current.exactSessionScore.toFixed(2)}%</strong>
      <p>
        Composite score · ending value{' '}
        {usdTwoDecimals.format(current.financials.portfolioValue)}
      </p>
    </article>
  </div>

  <div class="gm-session-table-wrapper">
    <table>
      <thead>
        <tr>
          <th scope="col">Comparable measure</th>
          <th scope="col">15 July</th>
          <th scope="col">22 July</th>
          <th scope="col">Change</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td>{row.prior}</td>
              <td>{row.current}</td>
              <td class:list={[`gm-change-${row.tone}`]}>{row.change}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="gm-session-note">
    The P&amp;L fields are shown for context but are not treated as directly
    comparable: the earlier portal column is labelled trading P&amp;L, while the
    principal-session figure is total P&amp;L. Cohort size and market path also
    differ. The strongest defensible comparison is therefore process-oriented:
    higher composite and BSRM scores, a higher ending portfolio value, lower
    commission paid and no recorded fat-finger incident in the later session.
  </p>
</section>

<style>
  .gm-session-comparison {
    margin: 1.5rem 0 2.3rem;
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: 0.55rem;
    background: color-mix(in srgb, currentColor 2.5%, transparent);
  }

  .gm-session-comparison > header {
    padding: 1.1rem 1.2rem 1rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 10%, transparent);
  }

  .gm-session-comparison > header p,
  .gm-session-summary span {
    margin: 0 0 0.4rem;
    font-size: 0.64rem;
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    opacity: 0.46;
  }

  .gm-session-comparison h3 {
    margin: 0;
    font-family: Georgia, Cambria, 'Times New Roman', Times, serif;
    font-size: 1.24rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .gm-session-summary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-bottom: 1px solid color-mix(in srgb, currentColor 10%, transparent);
  }

  .gm-session-summary article {
    padding: 1rem 1.2rem;
  }

  .gm-session-summary article + article {
    border-left: 1px solid color-mix(in srgb, currentColor 10%, transparent);
  }

  .gm-session-summary strong {
    display: block;
    font-family: Georgia, Cambria, 'Times New Roman', Times, serif;
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .gm-session-summary p {
    margin: 0.4rem 0 0;
    font-size: 0.72rem;
    line-height: 1.5;
    opacity: 0.52;
  }

  .gm-session-table-wrapper {
    overflow-x: auto;
  }

  .gm-session-comparison table {
    width: 100%;
    min-width: 46rem;
    border-collapse: collapse;
    font-size: 0.76rem;
  }

  .gm-session-comparison th,
  .gm-session-comparison td {
    padding: 0.72rem 0.8rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 8%, transparent);
    text-align: right;
    vertical-align: top;
  }

  .gm-session-comparison th:first-child,
  .gm-session-comparison tbody th {
    text-align: left;
  }

  .gm-session-comparison thead th {
    font-size: 0.62rem;
    font-weight: 650;
    letter-spacing: 0.075em;
    text-transform: uppercase;
    opacity: 0.45;
  }

  .gm-session-comparison tbody th {
    font-weight: 550;
    opacity: 0.7;
  }

  .gm-session-comparison tbody td {
    font-weight: 650;
  }

  .gm-change-positive {
    color: #69c894;
  }

  .gm-change-neutral {
    opacity: 0.52;
  }

  .gm-session-note {
    margin: 0;
    padding: 0.9rem 1.2rem 1rem;
    font-size: 0.7rem;
    line-height: 1.6;
    opacity: 0.5;
  }

  @media (max-width: 680px) {
    .gm-session-summary {
      grid-template-columns: 1fr;
    }

    .gm-session-summary article + article {
      border-top: 1px solid color-mix(in srgb, currentColor 10%, transparent);
      border-left: 0;
    }
  }
</style>
