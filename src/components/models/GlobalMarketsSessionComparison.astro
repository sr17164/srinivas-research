---
import { globalMarketsSimulation as simulation } from '~/data/globalMarketsSimulation'

const prior = simulation.priorBuySideSession
const current = simulation.buySide

const usd = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'USD',
  maximumFractionDigits: 0,
})

const getScore = (
  scores: readonly { label: string; value: number; display: string }[],
  label: string
) => {
  const score = scores.find((item) => item.label === label)
  if (!score) throw new Error(`Missing buy-side portal score: ${label}`)
  return score.value
}

const percentagePoint = (value: number) => `${value.toFixed(2)}pp`
const percentageChange = (currentValue: number, priorValue: number) =>
  ((currentValue - priorValue) / priorValue) * 100

const pnlChange = current.financials.portalPnl - prior.financials.portalPnl
const returnChange =
  current.financials.returnOnInitialFunds -
  prior.financials.returnOnInitialFunds
const sharpeChange =
  current.financials.sharpeRatio - prior.financials.sharpeRatio
const scoreChange = current.exactSessionScore - prior.exactSessionScore
const commissionReduction =
  Math.abs(prior.financials.commissionPaid) -
  Math.abs(current.financials.commissionPaid)

const subscoreChanges = {
  bsrm:
    getScore(current.portalSubscores, 'BSRM') -
    getScore(prior.portalSubscores, 'BSRM'),
  execution:
    getScore(current.portalSubscores, 'Execution') -
    getScore(prior.portalSubscores, 'ES'),
  ra:
    getScore(current.portalSubscores, 'RA') -
    getScore(prior.portalSubscores, 'RA'),
  roi:
    getScore(current.portalSubscores, 'ROI') -
    getScore(prior.portalSubscores, 'ROI'),
}

const rows = [
  {
    label: 'Composite score',
    prior: `${prior.exactSessionScore.toFixed(2)}%`,
    current: `${current.exactSessionScore.toFixed(2)}%`,
    change: `+${percentagePoint(scoreChange)}`,
    tone: 'positive',
  },
  {
    label: 'Leaderboard status',
    prior: `${prior.compositeLeaderboardRank}th of ${prior.participantCount}`,
    current: `Displayed ${current.displayedLeaderboardRank}nd of ${current.participantCount}`,
    change: 'Different cohorts',
    tone: 'neutral',
  },
  {
    label: 'Portal-reported P&L',
    prior: usd.format(prior.financials.portalPnl),
    current: usd.format(current.financials.portalPnl),
    change: `+${usd.format(pnlChange)} / +${percentageChange(
      current.financials.portalPnl,
      prior.financials.portalPnl
    ).toFixed(1)}%`,
    tone: 'positive',
  },
  {
    label: 'Return on initial funds',
    prior: `${prior.financials.returnOnInitialFunds.toFixed(1)}%`,
    current: `${current.financials.returnOnInitialFunds.toFixed(1)}%`,
    change: `+${returnChange.toFixed(1)}pp`,
    tone: 'positive',
  },
  {
    label: 'Sharpe ratio',
    prior: prior.financials.sharpeRatio.toFixed(2),
    current: current.financials.sharpeRatio.toFixed(2),
    change: `+${sharpeChange.toFixed(2)} / +${percentageChange(
      current.financials.sharpeRatio,
      prior.financials.sharpeRatio
    ).toFixed(1)}%`,
    tone: 'positive',
  },
  {
    label: 'BSRM platform subscore',
    prior: `${getScore(prior.portalSubscores, 'BSRM').toFixed(2)}%`,
    current: `${getScore(current.portalSubscores, 'BSRM').toFixed(2)}%`,
    change: `+${percentagePoint(subscoreChanges.bsrm)}`,
    tone: 'positive',
  },
  {
    label: 'Execution platform subscore',
    prior: `${getScore(prior.portalSubscores, 'ES').toFixed(2)}%`,
    current: `${getScore(current.portalSubscores, 'Execution').toFixed(2)}%`,
    change: `+${percentagePoint(subscoreChanges.execution)}`,
    tone: 'positive',
  },
  {
    label: 'RA platform subscore',
    prior: `${getScore(prior.portalSubscores, 'RA').toFixed(2)}%`,
    current: `${getScore(current.portalSubscores, 'RA').toFixed(2)}%`,
    change: `+${percentagePoint(subscoreChanges.ra)}`,
    tone: 'positive',
  },
  {
    label: 'ROI platform subscore',
    prior: `${getScore(prior.portalSubscores, 'ROI').toFixed(2)}%`,
    current: `${getScore(current.portalSubscores, 'ROI').toFixed(2)}%`,
    change: `+${percentagePoint(subscoreChanges.roi)}`,
    tone: 'positive',
  },
  {
    label: 'Commission paid',
    prior: usd.format(prior.financials.commissionPaid),
    current: usd.format(current.financials.commissionPaid),
    change: `${usd.format(commissionReduction)} lower / 3.5%`,
    tone: 'positive',
  },
  {
    label: 'Final equity allocation',
    prior: `${prior.finalAllocation.equities.toFixed(1)}%`,
    current: `${current.finalAllocation.equities.toFixed(1)}%`,
    change: 'Materially more concentrated',
    tone: 'caution',
  },
] as const

const progression = [
  {
    label: 'Composite score',
    prior: prior.exactSessionScore,
    current: current.exactSessionScore,
    priorDisplay: `${prior.exactSessionScore.toFixed(2)}%`,
    currentDisplay: `${current.exactSessionScore.toFixed(2)}%`,
  },
  {
    label: 'Portal P&L',
    prior: prior.financials.portalPnl,
    current: current.financials.portalPnl,
    priorDisplay: usd.format(prior.financials.portalPnl),
    currentDisplay: usd.format(current.financials.portalPnl),
  },
  {
    label: 'Return',
    prior: prior.financials.returnOnInitialFunds,
    current: current.financials.returnOnInitialFunds,
    priorDisplay: `${prior.financials.returnOnInitialFunds.toFixed(1)}%`,
    currentDisplay: `${current.financials.returnOnInitialFunds.toFixed(1)}%`,
  },
  {
    label: 'Sharpe ratio',
    prior: prior.financials.sharpeRatio,
    current: current.financials.sharpeRatio,
    priorDisplay: prior.financials.sharpeRatio.toFixed(2),
    currentDisplay: current.financials.sharpeRatio.toFixed(2),
  },
] as const
---

<section
  class="gm-session-comparison not-prose"
  aria-labelledby="gm-session-comparison-title"
>
  <header>
    <p>Repeated buy-side evidence</p>
    <h3 id="gm-session-comparison-title">
      22 July benchmark versus 29 July principal session
    </h3>
  </header>

  <div class="gm-session-summary">
    <article>
      <span>{prior.displayDate}</span>
      <strong>{prior.exactSessionScore.toFixed(2)}%</strong>
      <p>
        {usd.format(prior.financials.portalPnl)} P&amp;L · {
          prior.financials.returnOnInitialFunds.toFixed(1)
        }% return · {prior.financials.sharpeRatio.toFixed(2)} Sharpe
      </p>
    </article>
    <article>
      <span>{current.displayDate}</span>
      <strong>{current.exactSessionScore.toFixed(2)}%</strong>
      <p>
        {usd.format(current.financials.portalPnl)} portal P&amp;L · {
          current.financials.returnOnInitialFunds.toFixed(1)
        }% return · {current.financials.sharpeRatio.toFixed(2)} Sharpe
      </p>
    </article>
  </div>

  <div class="gm-progression" aria-label="Buy-side metric progression">
    {
      progression.map((metric) => {
        const maximum = Math.max(metric.prior, metric.current)
        const priorWidth = `${(metric.prior / maximum) * 100}%`
        const currentWidth = `${(metric.current / maximum) * 100}%`

        return (
          <article>
            <h4>{metric.label}</h4>
            <div class="gm-progression-row">
              <span>22 Jul</span>
              <div class="gm-progression-track" aria-hidden="true">
                <span style={`width:${priorWidth}`} />
              </div>
              <strong>{metric.priorDisplay}</strong>
            </div>
            <div class="gm-progression-row">
              <span>29 Jul</span>
              <div
                class="gm-progression-track gm-progression-track--current"
                aria-hidden="true"
              >
                <span style={`width:${currentWidth}`} />
              </div>
              <strong>{metric.currentDisplay}</strong>
            </div>
          </article>
        )
      })
    }
  </div>

  <div class="gm-session-table-wrapper">
    <table>
      <thead>
        <tr>
          <th scope="col">Comparable measure</th>
          <th scope="col">22 July</th>
          <th scope="col">29 July</th>
          <th scope="col">Change</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td>{row.prior}</td>
              <td>{row.current}</td>
              <td class:list={[`gm-change-${row.tone}`]}>{row.change}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="gm-session-note">
    The comparison is descriptive rather than causal: the sessions had different
    cohorts, market paths and news sequences. Absolute and risk-adjusted
    outcomes improved materially, but the allocation strategy also changed. The
    22 July portfolio finished 73.6% in cash, whereas the 29 July portfolio
    finished 99.5% in equities. The evidence therefore supports stronger
    measured output, not an unambiguous reduction in portfolio risk.
  </p>
</section>

<style>
  .gm-session-comparison {
    margin: 1.5rem 0 2.3rem;
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: 0.55rem;
    background: color-mix(in srgb, currentColor 2.5%, transparent);
  }

  .gm-session-comparison > header {
    padding: 1.1rem 1.2rem 1rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 10%, transparent);
  }

  .gm-session-comparison > header p,
  .gm-session-summary span {
    margin: 0 0 0.4rem;
    font-size: 0.64rem;
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    opacity: 0.46;
  }

  .gm-session-comparison h3 {
    margin: 0;
    font-family: Georgia, Cambria, 'Times New Roman', Times, serif;
    font-size: 1.24rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .gm-session-summary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-bottom: 1px solid color-mix(in srgb, currentColor 10%, transparent);
  }

  .gm-session-summary article {
    padding: 1rem 1.2rem;
  }

  .gm-session-summary article + article {
    border-left: 1px solid color-mix(in srgb, currentColor 10%, transparent);
  }

  .gm-session-summary strong {
    display: block;
    font-family: Georgia, Cambria, 'Times New Roman', Times, serif;
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .gm-session-summary p {
    margin: 0.4rem 0 0;
    font-size: 0.72rem;
    line-height: 1.5;
    opacity: 0.52;
  }

  .gm-progression {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 10%, transparent);
  }

  .gm-progression article {
    padding: 0.85rem 0.9rem;
    border: 1px solid color-mix(in srgb, currentColor 10%, transparent);
    border-radius: 0.45rem;
  }

  .gm-progression h4 {
    margin: 0 0 0.7rem;
    font-size: 0.66rem;
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: 0.075em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .gm-progression-row {
    display: grid;
    grid-template-columns: 2.6rem minmax(4rem, 1fr) auto;
    gap: 0.55rem;
    align-items: center;
  }

  .gm-progression-row + .gm-progression-row {
    margin-top: 0.48rem;
  }

  .gm-progression-row > span {
    font-size: 0.65rem;
    font-weight: 600;
    opacity: 0.45;
  }

  .gm-progression-row strong {
    font-size: 0.7rem;
    font-weight: 650;
    white-space: nowrap;
  }

  .gm-progression-track {
    overflow: hidden;
    height: 0.38rem;
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 8%, transparent);
  }

  .gm-progression-track span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: color-mix(in srgb, currentColor 34%, transparent);
  }

  .gm-progression-track--current span {
    background: #69c894;
  }

  .gm-session-table-wrapper {
    overflow-x: auto;
  }

  .gm-session-comparison table {
    width: 100%;
    min-width: 52rem;
    border-collapse: collapse;
    font-size: 0.76rem;
  }

  .gm-session-comparison th,
  .gm-session-comparison td {
    padding: 0.72rem 0.8rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 8%, transparent);
    text-align: right;
    vertical-align: top;
  }

  .gm-session-comparison th:first-child,
  .gm-session-comparison tbody th {
    text-align: left;
  }

  .gm-session-comparison thead th {
    font-size: 0.62rem;
    font-weight: 650;
    letter-spacing: 0.075em;
    text-transform: uppercase;
    opacity: 0.45;
  }

  .gm-session-comparison tbody th {
    font-weight: 550;
    opacity: 0.7;
  }

  .gm-session-comparison tbody td {
    font-weight: 650;
  }

  .gm-change-positive {
    color: #69c894;
  }

  .gm-change-neutral {
    opacity: 0.52;
  }

  .gm-change-caution {
    color: #c9a86a;
  }

  .gm-session-note {
    margin: 0;
    padding: 0.9rem 1.2rem 1rem;
    font-size: 0.7rem;
    line-height: 1.6;
    opacity: 0.5;
  }

  @media (max-width: 680px) {
    .gm-session-summary,
    .gm-progression {
      grid-template-columns: 1fr;
    }

    .gm-session-summary article + article {
      border-top: 1px solid color-mix(in srgb, currentColor 10%, transparent);
      border-left: 0;
    }
  }

  @media (max-width: 460px) {
    .gm-progression-row {
      grid-template-columns: 2.6rem minmax(3rem, 1fr);
    }

    .gm-progression-row strong {
      grid-column: 2;
    }
  }
</style>
