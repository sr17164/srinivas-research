---
import { globalMarketsSimulation as simulation } from '~/data/globalMarketsSimulation'

interface Props {
  mode: 'buy-side' | 'sell-side' | 'scores'
}

const { mode } = Astro.props

const usd = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'USD',
  maximumFractionDigits: 0,
})

const usdTwoDecimals = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'USD',
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
})

const numberTwoDecimals = new Intl.NumberFormat('en-US', {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
})

const buySideRows = [
  ['Portal-reported P&L', usd.format(simulation.buySide.financials.portalPnl)],
  [
    'Return on initial funds',
    `${simulation.buySide.financials.returnOnInitialFunds.toFixed(1)}%`,
  ],
  ['Sharpe ratio', simulation.buySide.financials.sharpeRatio.toFixed(2)],
  [
    'Portfolio-value field',
    usdTwoDecimals.format(simulation.buySide.financials.portfolioValueField),
  ],
  ['Commission paid', usd.format(simulation.buySide.financials.commissionPaid)],
  [
    'Average net exposure',
    usd.format(simulation.buySide.financials.averageNetExposure),
  ],
  [
    'Average contract exposure',
    numberTwoDecimals.format(
      simulation.buySide.financials.averageContractExposure
    ),
  ],
  [
    'Chat and voice trades',
    String(simulation.buySide.brokerDealing.chatAndVoiceTrades),
  ],
  ['Exchange trades', String(simulation.buySide.brokerDealing.exchangeTrades)],
  ['Quote trades', String(simulation.buySide.brokerDealing.quoteTrades)],
]

const sellSideRows = [
  ['Trading P&L', usd.format(simulation.sellSide.financials.tradingPnl)],
  [
    'Commission revenue',
    usd.format(simulation.sellSide.financials.commissionRevenue),
  ],
  ['Total P&L', usd.format(simulation.sellSide.financials.totalPnl)],
  [
    'Facilitation ratio',
    `${simulation.sellSide.financials.facilitationRatio}%`,
  ],
  [
    'Average net exposure',
    usd.format(simulation.sellSide.financials.averageNetExposure),
  ],
  [
    'Average contract exposure',
    numberTwoDecimals.format(
      simulation.sellSide.financials.averageContractExposure
    ),
  ],
  ['Exchange trades', String(simulation.sellSide.clientDealing.exchangeTrades)],
  ['Chat trades', String(simulation.sellSide.clientDealing.chatTrades)],
  ['Quote trades', String(simulation.sellSide.clientDealing.quoteTrades)],
  [
    'Average recorded exchange impact',
    `${simulation.sellSide.marketImpactAndControls.averageExchangeImpact}%`,
  ],
  [
    'Exchange fat-finger incidents',
    String(simulation.sellSide.marketImpactAndControls.exchangeFatFingers),
  ],
  [
    'Client fat-finger incidents',
    String(simulation.sellSide.marketImpactAndControls.clientFatFingers),
  ],
]

const rows = mode === 'buy-side' ? buySideRows : sellSideRows
---

{
  mode === 'scores' ? (
    <section
      class="gm-score-section not-prose"
      aria-label="Platform score comparison"
    >
      <div class="gm-score-intro">
        <div>
          <span>Asset management · principal session</span>
          <strong>{simulation.buySide.exactSessionScore.toFixed(2)}%</strong>
          <p>
            {simulation.buySide.displayDate} · displayed{' '}
            {simulation.buySide.displayedLeaderboardRank}nd of{' '}
            {simulation.buySide.participantCount}; highest valid after the
            first-place result was voided.
          </p>
        </div>
        <div>
          <span>Sell-side trading · principal session</span>
          <strong>{simulation.sellSide.exactSessionScore.toFixed(2)}%</strong>
          <p>
            {simulation.sellSide.displayDate} · sell-side rank{' '}
            {simulation.sellSide.overallLeaderboardRank}th of{' '}
            {simulation.sellSide.participantCount}
          </p>
        </div>
      </div>

      <div class="gm-score-grid">
        <article>
          <h3>Asset-management platform subscores</h3>
          <dl>
            {simulation.buySide.portalSubscores.map((score) => (
              <div>
                <dt>{score.label} platform subscore</dt>
                <dd>{score.display}</dd>
              </div>
            ))}
          </dl>
        </article>

        <article>
          <h3>Sell-side platform subscores</h3>
          <dl>
            {simulation.sellSide.portalSubscores.map((score) => (
              <div>
                <dt>{score.label}</dt>
                <dd>{score.display}</dd>
              </div>
            ))}
          </dl>
        </article>
      </div>

      <p class="gm-score-note">
        The 100% ROI figure is a proprietary platform subscore, not a 100%
        investment return. BSRM, FFC, RA, CT and SSRM are retained as portal
        labels because complete official definitions and the weighting formula
        are unavailable. Platform scoring is interpreted separately from actual
        portfolio concentration and simulated P&amp;L.
      </p>
    </section>
  ) : (
    <div class="gm-metrics not-prose">
      <div class="gm-metrics-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">Metric</th>
              <th scope="col">Result</th>
            </tr>
          </thead>
          <tbody>
            {rows.map(([label, value]) => (
              <tr>
                <th scope="row">{label}</th>
                <td>{value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {mode === 'buy-side' && (
        <p class="gm-metrics-note">
          The $3.80 million figure is reproduced as portal-reported P&amp;L. The
          detailed view labels it total P&amp;L, while the leaderboard labels
          the same value trading P&amp;L. The portfolio-value field is shown
          separately because it does not mechanically reconcile with P&amp;L and
          commission.
        </p>
      )}
    </div>
  )
}

<style>
  .gm-metrics,
  .gm-score-section {
    margin: 1.4rem 0 2.2rem;
  }

  .gm-metrics-scroll {
    overflow-x: auto;
    border-top: 1px solid color-mix(in srgb, currentColor 16%, transparent);
    border-bottom: 1px solid color-mix(in srgb, currentColor 16%, transparent);
  }

  .gm-metrics table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
  }

  .gm-metrics th,
  .gm-metrics td {
    padding: 0.76rem 0.7rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 9%, transparent);
  }

  .gm-metrics tr:last-child th,
  .gm-metrics tr:last-child td {
    border-bottom: 0;
  }

  .gm-metrics thead th {
    font-size: 0.64rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.46;
  }

  .gm-metrics th {
    text-align: left;
  }

  .gm-metrics td,
  .gm-metrics thead th:last-child {
    text-align: right;
  }

  .gm-metrics tbody th {
    font-weight: 550;
    opacity: 0.72;
  }

  .gm-metrics tbody td {
    font-weight: 650;
  }

  .gm-metrics-note,
  .gm-score-note {
    margin: 0.85rem 0 0;
    font-size: 0.7rem;
    line-height: 1.6;
    opacity: 0.5;
  }

  .gm-score-intro {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid color-mix(in srgb, currentColor 15%, transparent);
    border-bottom: 1px solid color-mix(in srgb, currentColor 15%, transparent);
  }

  .gm-score-intro > div {
    padding: 1rem 1.1rem;
  }

  .gm-score-intro > div + div {
    border-left: 1px solid color-mix(in srgb, currentColor 11%, transparent);
  }

  .gm-score-intro span,
  .gm-score-grid dt {
    display: block;
    font-size: 0.64rem;
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: 0.085em;
    text-transform: uppercase;
    opacity: 0.46;
  }

  .gm-score-intro strong {
    display: block;
    margin-top: 0.35rem;
    font-family: Georgia, Cambria, 'Times New Roman', Times, serif;
    font-size: 1.55rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .gm-score-intro p {
    margin: 0.35rem 0 0;
    font-size: 0.72rem;
    line-height: 1.45;
    opacity: 0.52;
  }

  .gm-score-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    margin-top: 0.85rem;
  }

  .gm-score-grid article {
    padding: 1rem 1.1rem;
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: 0.5rem;
    background: color-mix(in srgb, currentColor 2.5%, transparent);
  }

  .gm-score-grid h3 {
    margin: 0 0 0.75rem;
    font-family: Georgia, Cambria, 'Times New Roman', Times, serif;
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .gm-score-grid dl {
    margin: 0;
  }

  .gm-score-grid dl div {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.58rem 0;
    border-top: 1px solid color-mix(in srgb, currentColor 9%, transparent);
  }

  .gm-score-grid dd {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 650;
    text-align: right;
  }

  @media (max-width: 680px) {
    .gm-score-intro,
    .gm-score-grid {
      grid-template-columns: 1fr;
    }

    .gm-score-intro > div + div {
      border-top: 1px solid color-mix(in srgb, currentColor 11%, transparent);
      border-left: 0;
    }
  }
</style>
