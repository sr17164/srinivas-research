---
import ContributorArticle from '~/components/contributors/ContributorArticle.astro'
import { getFilteredContributorResearch } from '~/utils/data'

export async function getStaticPaths() {
  const posts = await getFilteredContributorResearch()

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
---

<ContributorArticle {post} />
