---
import BaseLayout from '~/layouts/BaseLayout.astro'
import StandardLayout from '~/layouts/StandardLayout.astro'
import ListView from '~/components/views/ListView.astro'
import PageNavigation from '~/components/nav/PageNavigation.astro'
import Link from '~/components/base/Link.astro'
import { withBasePath } from '~/utils/path'
---

<BaseLayout
  title="Research"
  description="Independent cross-asset research on commodities, rates, currencies, macroeconomic forces and decisions under uncertainty."
  bgType="plum"
  ogImage="fallback"
>
  <StandardLayout>
    <section slot="article" class="research-index">
      <header class="research-index-header">
        <p class="research-index-eyebrow">Founder-authored research</p>

        <h1>Research</h1>

        <p class="research-index-intro">
          Research by Srinivas Medida across commodities, rates, currencies,
          macroeconomic forces and valuation, with explicit catalysts, risks,
          implementation frameworks and invalidation conditions. This is the
          only channel that informs Current Views and the Decision Log.
        </p>

        <Link
          href={withBasePath('/outcomes/')}
          class="research-index-outcomes border-b-none!"
        >
          View the decision log
          <span aria-hidden="true">↗</span>
        </Link>

        <div class="research-index-rule"></div>
      </header>

      <ListView pageTag={false} />

      <PageNavigation current="research" />
    </section>
  </StandardLayout>
</BaseLayout>
